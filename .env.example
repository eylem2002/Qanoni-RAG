# Root environment for local development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qanooni

# API auth
ADMIN_PASSWORD=change-me

# Runtime / frontend build config
PORT=3001        # API server port
VITE_PORT=4001   # RAG admin dashboard (legal-ai frontend)
BASE_PATH=/
LOG_LEVEL=info

# Qanooni integration — when set, the RAG server calls Qanooni's cache
# invalidation endpoint after each law-change acknowledgment so Qanooni
# immediately re-fetches updated law text on the next contract generation.
# Leave unset to disable the webhook (Qanooni's 1-hour TTL cache will still
# pick up changes naturally).
QANOONI_BASE_URL=http://localhost:5001